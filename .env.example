# Desarrollo local. No se necesitan credenciales para datos públicos.
PUBLIC_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=*
DATASET_BASE=estadisticas_municipio
REQUEST_TIMEOUT=60
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=64
EDUCADATOS_CACHE_DIR=/tmp/educadatos-cache
DEFAULT_LIMIT=100000
MAX_LIMIT=1000000
DEFAULT_ANALYTIC_LIMIT=100000
MIN_LIMIT_MUNICIPAL=100000
MIN_LIMIT_DEPARTAMENTAL=500000
